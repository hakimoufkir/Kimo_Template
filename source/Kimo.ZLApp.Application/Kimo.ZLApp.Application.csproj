<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Kimo.ZLApp.Domain\Kimo.ZLApp.Domain.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0"/>
        <PackageReference Include="Riok.Mapperly" Version="4.2.1"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="**/*.cs" Condition="!$([System.String]::Copy('%(Filename)').EndsWith('Handler'))">
            <DependentUpon>%(Filename)Handler.cs</DependentUpon>
        </Compile>

        <Compile Update="**/*Logs.cs">
            <DependentUpon>$([System.String]::Copy('%(Filename)').Replace('Logs', '.cs'))</DependentUpon>
        </Compile>
    </ItemGroup>

</Project>
